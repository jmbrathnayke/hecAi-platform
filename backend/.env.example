DATABASE_URL=postgresql://user:password@localhost:5432/hec_platform
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-settings
FLASK_DEBUG=false

# Twilio SMS fallback channel (Story 3.6, FR-1.4). Officer-initiated inbound SMS.
# Leave unset until the DWC Twilio number is provisioned — the webhook fails signature
# validation closed (403) without TWILIO_AUTH_TOKEN, so no spoofed cases can be created.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+94xxxxxxxxx
# The externally-visible HTTPS URL Twilio is configured to POST to. Twilio signs THIS exact URL;
# behind a proxy it differs from request.url, so signature validation uses this value.
TWILIO_PUBLIC_WEBHOOK_URL=https://your-backend-host/api/v1/sms/inbound

# Supabase project URL; the auth guards derive the JWKS endpoint from it for ES256 verification.
# Must be https:// (or http://localhost for `supabase start`) — create_app() refuses anything else,
# since this string is the trust root for every signing key the API fetches.
SUPABASE_URL=https://your-project.supabase.co

# Optional override for the derived JWKS endpoint. It OUTRANKS SUPABASE_URL, so a stale value
# here silently redefines what the guards trust — documented rather than left to be discovered in
# the source. Leave unset unless you are pointing at a non-standard Supabase deployment.
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Household registry pepper (Story 8.1, FR-10.2). Keys the HMAC behind "one registered claimant
# per family" — see app/infrastructure/security/nic_identity.py.
#
# Generate once with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# ROTATING THIS IRRECOVERABLY INVALIDATES THE HOUSEHOLD REGISTRY. Every nic_hmac changes, no
# stored digest can be re-derived, and every household must register again. There is no recovery
# path by design. Back it up with the same custody as DATABASE_URL. (Risk R-13.)
#
# Unset in tests, which pass an explicit pepper. Registration returns 500 server_misconfigured
# without it rather than falling back to a guessable default.
NIC_PEPPER=generate-a-long-random-value-and-never-rotate-it

# Bank-detail encryption key (Story 8.6, FR-10.4). Fernet, server-side — the Divisional
# Secretariat must be able to READ an account number to pay it, so unlike NIC_PEPPER this is
# reversible encryption. See app/infrastructure/security/bank_crypto.py.
#
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Rotatable, unlike NIC_PEPPER — but a rotation means decrypting every household row with the old
# key and re-encrypting with the new one. No script does that yet; treat it as a migration.
#
# ETHICS DEPENDENCY (Risk R-14): the NSBM ethics submission predates this feature and does not yet
# cover bank data. Until it does, enter ONLY synthetic or test account numbers.
BANK_DETAILS_KEY=generate-a-fernet-key-see-above
